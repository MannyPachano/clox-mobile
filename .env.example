# Copy to .env and fill in. These are the SAME public client values your
# website uses (Supabase project URL + publishable/anon key). EXPO_PUBLIC_*
# vars are exposed to the app bundle by Expo.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Where the mobile API lives. Production by default; point at your machine's LAN
# URL (e.g. http://192.168.1.50:3000) to test against a local web server.
EXPO_PUBLIC_API_BASE_URL=https://app.getclox.com
