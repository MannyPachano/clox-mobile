node_modules/
# No trailing slash: a node_modules symlink (a shared worktree install) is a
# file, and "node_modules/" only matches folders.
/node_modules
.expo/
dist/
web-build/
*.log
.DS_Store

# Local secrets — the publishable keys are safe to ship, but keep .env out of git
# anyway and use .env.example as the template.
.env

# Google Play submit credential (service-account JSON from Play Console).
# It's a secret — never commit it. Referenced by eas.json submit.production.android.
google-play-service-account.json

# Native projects are generated by `expo prebuild` on EAS from app.json and
# plugins/. Committing either folder would make EAS treat the project as bare
# and ignore the native settings in app.json.
/ios
/android

# Written into targets/ by @bacons/apple-targets at every prebuild, from
# targets/*/expo-target.config.js (the entitlements and the colors). EAS
# regenerates them; the config is the source.
/targets/*/generated.entitlements
/targets/*/Assets.xcassets
