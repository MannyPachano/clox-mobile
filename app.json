{
  "expo": {
    "name": "Clox",
    "slug": "clox-mobile",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clox",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3efe7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.getclox.clock",
      "appleTeamId": "5SLN735JRC",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Clox checks your location only when you clock in or out, to confirm you're at the job site. It does not track you in the background.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Clox uses Face ID so you can unlock the app and clock in quickly, even offline. Your face data never leaves your device.",
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production",
        "com.apple.developer.networking.wifi-info": true,
        "com.apple.security.application-groups": [
          "group.com.getclox.clock"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.getclox.clock",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#b84a2c"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA"
      ],
      "config": {}
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Clox checks your location only when you clock in or out, to confirm you're at the job site. It does not track you in the background."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Clox can take a clock-in selfie to confirm it's you. It is optional and only used if your employer turns it on.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#b84a2c"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Clox uses Face ID so you can unlock the app and clock in quickly, even offline. Your face data never leaves your device."
        }
      ],
      "@bacons/apple-targets",
      "./plugins/with-extension-versions"
    ],
    "extra": {
      "eas": {
        "projectId": "2dcdc983-13fa-4199-8a2d-362e610d7d80"
      }
    },
    "owner": "cloxlabs",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2dcdc983-13fa-4199-8a2d-362e610d7d80"
    }
  }
}
