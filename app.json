{
  "expo": {
    "name": "Clox",
    "slug": "clox-mobile",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clox",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3efe7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.getclox.clock",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Clox checks your location only when you clock in or out, to confirm you're at the job site. It does not track you in the background.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Clox uses Face ID so you can unlock the app and clock in quickly, even offline. Your face data never leaves your device."
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production",
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "com.getclox.clock",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#b84a2c"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "config": {}
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Clox checks your location only when you clock in or out, to confirm you're at the job site. It does not track you in the background."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Clox can take a clock-in selfie to confirm it's you. It is optional and only used if your employer turns it on.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#b84a2c"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Clox uses Face ID so you can unlock the app and clock in quickly, even offline. Your face data never leaves your device."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2dcdc983-13fa-4199-8a2d-362e610d7d80"
      }
    },
    "owner": "cloxlabs",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2dcdc983-13fa-4199-8a2d-362e610d7d80"
    }
  }
}
